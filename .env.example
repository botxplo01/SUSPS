# @author: Lameck David Musumpuka

###########################################################
# 🌍 SUSPS – Nairobi Data Environment (.env)
# ---------------------------------------------------------
# Environment configuration for all data sources.
# Supports both local data directories and AWS S3 storage.
###########################################################

DEFAULT_DATA_SOURCE='api'
DATA_CITY='Nairobi'

# ================================
# * 1. DEMOGRAPHICS & POPULATION
# ================================
WORLDPOP_PATH='data/<CITY>/raw/Demographics_and_Population/ken_ppp_2020_main_file.tif'
GRID3_POP_PATH='data/<CITY>/raw/Demographics_and_Population/KEN_population_v1_0_gridded_estimates.tif'
POP_ANNUAL_CHANGE_PATH='data/<CITY>/raw/Demographics_and_Population/Nairobi_Population_Annual_Change.csv'
CENSUS_TOTAL_PATH='data/<CITY>/raw/Demographics_and_Population/Nairobi_Population_Total_Population_By_Year.csv'


# ================================
# * 2. MOBILITY & TRANSPORT
# ================================
MATATUS_PATH='data/<CITY>/raw/Mobility_and_Transport/GIS_DATA_2019.zip'
TOMTOM_API_KEY='YOUR_TOMTOM_API_KEY'  # Replace with actual key
TRAFFIC_LIVE_GRID_N='5'
TRAFFIC_LIVE_RADIUS_DEG='0.08'
TRAFFIC_LIVE_ZOOM='16'
TRAFFIC_LIVE_MAX_POINTS='25'
OSM_PATH='data/<CITY>/raw/Mobility_and_Transport/kenya_251108.osm.pbf'


# ================================
# * 3. ENVIRONMENTAL & CLIMATE
# ================================
# Weather and Air Quality
OPENWEATHER_API_KEY='YOUR_OPENWEATHER_API_KEY'  # Replace with actual key
OPEN_AQ_API_KEY='YOUR_OPENAQ_API_KEY'  # Replace with actual key
# Provider toggles
WEATHER_PROVIDER='openweather'   # or 'open-meteo'
TRAFFIC_PROVIDER='tomtom'        # or 'synthetic'

# Land coverage datasets
LANDCOVER_PATH_2015='data/<CITY>/raw/Environmental_and_Climate/land_coverage_kenya.tiff'


# ================================
# * 4. ENERGY & INFRASTRUCTURE
# ================================
ENERGY='data/<CITY>/raw/Energy_and_Infrastructure'


# ================================
# * 5. SMART CITY & URBAN GROWTH
# ================================
GRID3_SETTLEMENTS_PATH='data/<CITY>/raw/Urban_Growth'


# =========================================
# * 6. AI & ADVISORY ENGINE (Hugging Face)
# =========================================
HF_API_KEY='YOUR_HF_API_KEY'  # Replace with actual key
HF_MODEL_NAME='meta-llama/Llama-3.1-8B-Instruct'
# Optional specialized models for time-series and geospatial tasks
HF_GROWTH_TS_MODEL="google/flan-t5-large"
HF_ENERGY_TS_MODEL="google/flan-t5-large"
HF_TRAFFIC_TS_MODEL="google/flan-t5-large"
HF_GEOSPATIAL_MODEL="meta-llama/Llama-3.1-8B-Instruct"


# ================================
# * 7. DATABASE CONFIGURATION
# ================================
# Toggle between local and online databases
USE_LOCAL_DB=true

# Local PostgreSQL (Development)
LOCAL_DATABASE_URL='postgres://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/susps_db_local'

# Render PostgreSQL (Production)
DATABASE_URL='postgres://susps_admin:YOUR_PRODUCTION_PASSWORD@RENDER_EXTERNAL_DATABASE_URL/susps_db_online'

# Spatial reference system
DB_SPATIAL_CRS='EPSG:4326'
DB_TIMEOUT=30


# ================================
# * 8. CLOUD STORAGE (AWS S3)
# ================================
# Controls where raw data is loaded from (local vs S3)
USE_S3_STORAGE=false

# AWS Credentials (use IAM user with S3 Read-Only Access)
AWS_ACCESS_KEY_ID='YOUR_AWS_ACCESS_KEY_ID'  # Replace with actual key
AWS_SECRET_ACCESS_KEY='YOUR_AWS_SECRET_ACCESS_KEY'  # Replace with actual key

# Bucket Configuration
AWS_BUCKET_NAME='your_bucket_name'  # e.g. susps-data-bucket
AWS_REGION='your_bucket_region'   # e.g. us-east-1

# Base prefix or folder inside the bucket (if you grouped files)
AWS_S3_DATA_PREFIX='data/<CITY>/raw/'
